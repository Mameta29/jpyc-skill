  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/yargs": "^17.0.35",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@komlock-lab/acli": ">=0.1.3"
