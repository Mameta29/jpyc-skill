    "eip-3009",
    "gasless"
  ],
  "author": "Komlock-lab",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Komlock-lab/acli-jpyc-ec.git"
  },
