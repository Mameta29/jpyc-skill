{
  "name": "@komlock-lab/jpyc-ec",
  "version": "0.1.0",
  "description": "JPYC EC Platform purchase plugin for acli (browse / quote / buy / track with gasless EIP-3009 signing)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
