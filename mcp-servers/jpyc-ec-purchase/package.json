    "eip-3009",
    "gasless",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "author": "Mameta29",
  "homepage": "https://github.com/Mameta29/jpyc-skill/tree/main/mcp-servers/jpyc-ec-purchase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mameta29/jpyc-skill.git",
    "directory": "mcp-servers/jpyc-ec-purchase"
  },
  "bugs": {
    "url": "https://github.com/Mameta29/jpyc-skill/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
